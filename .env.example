# Airflow
AIRFLOW_UID=50000

# Pip packages for Airflow
_PIP_ADDITIONAL_REQUIREMENTS=docker elasticsearch pandas pyarrow boto3

# AccesLibre (public API, no key required)
# ACCES_LIBRE_PAGE_SIZE=100
# ACCES_LIBRE_MAX_PAGES=1

# Open-Meteo (free API, no key required)
# OPEN_METEO_FORECAST_DAYS=3
# OPEN_METEO_MAX_LOCATIONS=25
# OPEN_METEO_TIMEZONE=Europe/Paris
# DEFAULT_CITY=Paris
# DEFAULT_LATITUDE=48.8566
# DEFAULT_LONGITUDE=2.3522

# Kafka
# KAFKA_BOOTSTRAP_SERVER=localhost:9092
# WEATHER_STREAM_TOPIC=weather.raw.current

# S3 (LocalStack)
# S3_ENDPOINT=http://localstack:4566
